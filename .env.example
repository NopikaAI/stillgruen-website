# Diese Datei in ".env" umbenennen und ausfüllen, oder die Werte im Hostinger-Panel eintragen.

# Adresse der Website (ohne Schrägstrich am Ende)
SITE_URL=https://www.xn--stillgrn-d6a.de
NODE_ENV=production
PORT=3000
# true: alle Aufrufe werden auf https und www.stillgrün.de umgeleitet
FORCE_CANONICAL=true

# MySQL-Datenbank von Hostinger
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# E-Mail-Postfach von Hostinger, damit jede Anfrage sofort als Mail ankommt
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=kontakt@stillgruen.de
SMTP_PASSWORD=
MAIL_TO=kontakt@stillgruen.de

# Zugang zur Anfragenliste unter /admin
ADMIN_USER=kerstin
ADMIN_PASSWORD=

# Google Analytics und Google Ads (leer lassen = kein Banner, nichts von Google)
# Sobald eine ID eingetragen ist, erscheint das Einwilligungs-Banner automatisch.
GA_ID=
GOOGLE_ADS_ID=
